
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDING
}

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}

enum Role {
  ADMIN
  USER
}

model User {
  id String @id @default(uuid())
  fullName String
  phoneNumber String @unique
  email String @unique
  password String
  role Role @default(USER)
  refreshToken String?

  payment Payment[]
  bill Bill[]

  @@index([phoneNumber])
  @@map("users")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?

  bills       Bill[]

  createdAt   DateTime @default(now())
}

model Bill {
  id String @id @default(uuid())
  amount Int 

  userId String
  user User @relation(fields: [userId], references: [id])

  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id])

  payment Payment[]

  dueDate DateTime

  @@map("bills")
}

model Payment {
  id String @id @default(uuid())
  status PaymentStatus @default(PENDING)
  amount String

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   billId    String
  bill      Bill @relation(fields: [billId], references: [id])

  @@map("payment")
}